{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ToolUsageAPIContract",
  "description": "API Contract for GET /api/reports/tool-usage",
  "endpoints": {
    "GET /api/reports/tool-usage": {
      "queryParameters": {
        "machine": { "type": "string" },
        "pastDays": { "type": "integer", "default": 30 },
        "futureDays": { "type": "integer", "default": 30 }
      },
      "response": {
        "status": 200,
        "body": {
          "type": "object",
          "required": ["records", "summary"],
          "properties": {
            "records": { "type": "array" },
            "summary": { "type": "object" }
          }
        }
      }
    }
  }
}
