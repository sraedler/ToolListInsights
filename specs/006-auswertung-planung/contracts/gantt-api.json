{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GanttAPIContract",
  "description": "API Contract for GET /api/reports/gantt & GET /api/planning",
  "endpoints": {
    "GET /api/reports/gantt": {
      "queryParameters": {
        "weeksCount": { "type": "integer", "default": 4, "minimum": 1, "maximum": 52 }
      },
      "response": {
        "status": 200,
        "body": {
          "type": "object",
          "required": ["ganttRows", "weeklyLoad"],
          "properties": {
            "ganttRows": { "type": "array" },
            "weeklyLoad": { "type": "array" }
          }
        }
      }
    },
    "GET /api/planning": {
      "queryParameters": {
        "startDate": { "type": "string" },
        "daysCount": { "type": "integer", "default": 5 },
        "optimize": { "type": "boolean", "default": true },
        "poolOptimization": { "type": "boolean", "default": false },
        "nightRunOptimization": { "type": "boolean", "default": true },
        "useD4Plan": { "type": "boolean", "default": false },
        "includeNonGreen": { "type": "boolean", "default": true }
      },
      "response": {
        "status": 200,
        "body": {
          "type": "object",
          "required": ["board"],
          "properties": {
            "board": { "type": "object" }
          }
        }
      }
    }
  }
}
